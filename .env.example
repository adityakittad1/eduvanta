# ==============================================================
# ZP School ERP — Environment Variables
# ==============================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ==============================================================

# --------------------------------------------------------------
# Application
# --------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
REACT_APP_ROOT_DOMAIN=example.com

# --------------------------------------------------------------
# Database
# --------------------------------------------------------------
DATABASE_URL=postgresql://zpuser:zppassword@localhost:5432/zpschoolerp

# --------------------------------------------------------------
# JWT Authentication
# --------------------------------------------------------------
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------
# File Uploads
# --------------------------------------------------------------
# Absolute path where uploaded files are stored (inside container: /app/uploads)
FILE_UPLOAD_DIR=./uploads
FILE_UPLOAD_MAX_SIZE_MB=50

# --------------------------------------------------------------
# AI Assistant (Phase 14 — leave empty until Phase 14)
# --------------------------------------------------------------
AI_PROVIDER=gemini
# AI_API_KEY=your_api_key_here
# AI_MODEL=gemini-1.5-pro

# --------------------------------------------------------------
# Logging
# --------------------------------------------------------------
LOG_LEVEL=info

# --------------------------------------------------------------
# Docker / Postgres (used by docker-compose)
# --------------------------------------------------------------
POSTGRES_DB=zpschoolerp
POSTGRES_USER=zpuser
POSTGRES_PASSWORD=zppassword
